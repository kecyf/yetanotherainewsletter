---
// the prompt card: the only boxed element on the page besides the fleet note, and the only
// component with the accent fill. it serves the issue page (a dated prompt) and /api (the api prompt).
import Title from './Title.astro';
import { copy } from '../content/copy';
import { codeHtml } from '../lib/codeHtml';

interface Props {
  prompt: string;
  title?: string;
  instruction?: string;
}
const { prompt, title = copy.agentBlock.title, instruction = copy.agentBlock.instruction } = Astro.props;
---

<section id="agent" class="bg-surface border border-line rounded-2 p-4 flex flex-col gap-4 min-w-0">
  <div class="flex flex-col gap-2">
    <Title level={2}>{title}</Title>
    <p class="text-micro text-fg-3">{instruction}</p>
  </div>
  <pre id="prompt" class="codeblock codeblock-wrap font-mono text-micro" tabindex="0" role="region" aria-label={title} set:html={codeHtml(prompt)} />
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <button
      class="btn cta-fill"
      type="button"
      hidden
      data-copy="prompt"
      data-copied={copy.agentBlock.copied}
      data-copy-failed={copy.agentBlock.copyFailed}
    >{copy.agentBlock.copyButton}</button>
    <span class="text-micro text-success" role="status" data-status></span>
    <div class="flex flex-wrap items-center gap-x-2 -ml-2"><slot /></div>
  </div>
</section>
