---
import { copy } from '../content/copy';

interface Props {
  items: { title: string; url: string; agent: string; reason: string }[];
}
const { items } = Astro.props;
if (items.length === 0) throw new Error('the dropped list is required whenever dropped > 0');
const summary = copy.droppedList.summary.replace('{count}', String(items.length));
---

<!-- v1.3: no box. a rule and a tap-high summary row; the list opens under it -->
<details class="border-t border-line">
  <summary class="flex items-center gap-2 min-h-tap font-mono text-micro text-fg-3"><span class="mark"></span> {summary}</summary>
  <ul class="flex flex-col gap-4 pt-2 pb-4">
    {items.map((it) => (
      <li class="flex flex-col gap-1">
        <a class="link-quiet tap text-fg-1" href={it.url}>{it.title}</a>
        <span class="font-mono text-micro text-fg-3">{it.agent} · {it.reason}</span>
      </li>
    ))}
  </ul>
</details>
