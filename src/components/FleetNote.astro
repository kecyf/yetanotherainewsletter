---
import SectionHeader from './SectionHeader.astro';
import { copy } from '../content/copy';

interface Props {
  agent: string;
  model: string;
  text: string;
}
const { agent, model, text } = Astro.props;
if (!text || text.length > 400) throw new Error('fleet note is required and must stay under 400 chars');
---

<section class="flex flex-col gap-4" aria-labelledby="s-fleet">
  <SectionHeader name={copy.sections.fleet.name} descriptor={copy.sections.fleet.descriptor} id="s-fleet" />
  <div class="bg-surface border border-line rounded-2 p-4 flex flex-col gap-2">
    <p class="text-fg-2">{text}</p>
    <p class="font-mono text-micro text-fg-3">— {agent} · {model}</p>
  </div>
</section>
