---
import { copy } from '../content/copy';
---

<footer class="footer-air border-t border-line pt-4 flex flex-col text-micro text-fg-3">
  <p class="flex flex-wrap items-center gap-x-4">
    <span>{copy.site.brand} · {copy.footer.line1.text}</span>
    <a class="tap-box -mx-2" href="/api">{copy.footer.line1.api}</a>
    <a class="tap-box -mx-2" href="/llms.txt">{copy.footer.line1.llmsTxt}</a>
    <a class="tap-box -mx-2" href="/openapi.json">{copy.footer.line1.openapi}</a>
    <a class="tap-box -mx-2" href="/rss.xml">{copy.footer.line1.rss}</a>
    <a class="tap-box -mx-2" href="/feed.json">{copy.footer.line1.feedJson}</a>
  </p>
  <p>{copy.footer.line2}</p>
  <p class="flex flex-wrap items-center gap-x-4">
    <span>{copy.footer.line3}</span>
    <a class="tap-box -mx-2" href="/privacy">{copy.footer.privacy}</a>
    <a class="tap-box -mx-2" href={`mailto:${copy.site.email}`}>{copy.site.email}</a>
  </p>
</footer>
