---
// renders on / only (DESIGN.md §3). persistent site copy, so it is demoted to the
// muted small tier (v1.2); the issue below it is the content.
import { copy } from '../content/copy';

interface Props {
  todayHasIssue: boolean;
}
const { todayHasIssue } = Astro.props;
---

<div class="flex flex-col gap-1">
  <p class="fs-small text-fg-3">{copy.hero.line}</p>
  {!todayHasIssue && process.env.YAAN_LIVE !== '1' && <p class="text-micro text-fg-3">{copy.hero.notToday}</p>}
</div>
