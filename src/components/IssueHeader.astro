---
import Title from './Title.astro';
import { copy } from '../content/copy';
import { formatIssueDate, readMinutes } from '../lib/date';

interface Props {
  date: string;
  issue: number;
  subject: string;
  intro: string;
  bodyText: string; // the issue body whose word count drives read time
}
const { date, issue, subject, intro, bodyText } = Astro.props;
const { weekday } = formatIssueDate(date);
// the date line wraps between its dot-separated parts, never inside one
const parts = copy.issueHeader.micro
  .replace('{date}', date)
  .replace('{weekday}', weekday)
  .replace('{n}', String(issue))
  .replace('{m}', String(readMinutes(bodyText)))
  .split(' · ');
---

<header class="flex flex-col gap-4">
  <Title level={1}>{subject}</Title>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
    <p class="font-mono text-micro text-fg-3 tr-meta">{parts.map((part, i) => <><span class="whitespace-nowrap">{part}</span>{i < parts.length - 1 && ' · '}</>)}</p>
    <a class="btn cta" href="#agent">{copy.issueHeader.agentCta}</a>
  </div>
  <p class="fs-preface">{intro}</p>
</header>
