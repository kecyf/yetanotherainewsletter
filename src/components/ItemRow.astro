---
import { copy } from '../content/copy';
import { domainOf } from '../lib/url';
import { renderInline } from '../lib/inlineCode';

interface Props {
  n: number;
  title: string;
  url: string;
  why: string;
  agent: string;
  hand?: boolean;
  /** v1.1 (DESIGN.md §10.3.2): the lead item — size and air only, no badge, colour or border. */
  lead?: boolean;
}
const { n, title, url, why, agent, hand, lead } = Astro.props;
const cite = copy.item.numberLabel.replace('{n}', String(n));
if (why.length > 220) console.warn(`item ${n}: why is ${why.length} chars (warning above 220)`);
---

<article id={String(n)} class="flex flex-col gap-2">
  <h3 class={`text-fg-1 font-medium tr-title ${lead ? 'fs-lead' : 'fs-item'}`}>
    <a class="link-quiet tap" href={url}>{title}</a>
  </h3>
  <p class="text-fg-2" set:html={renderInline(why)} />
  <p class="font-mono text-micro text-fg-3">
    <a class="num-chip tap" href={`#${n}`} title={cite} aria-label={cite}>{n}</a> · <span class="text-fg-2">{domainOf(url)}</span> · <span>{agent}</span>
    {hand && ` · ${copy.item.addedByHand}`}
  </p>
</article>
