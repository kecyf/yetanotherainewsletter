---
import { copy } from '../content/copy';
import { formatUtcTime } from '../lib/date';

interface Props {
  sources: number;
  read: number;
  proposed: number;
  dropped: number;
  hand: number;
  kept: number;
  models: string[];
  assembled: string;
  curator: string;
}
const { sources, read, proposed, dropped, hand, kept, models, assembled, curator } = Astro.props;
if (kept !== proposed - dropped + hand) {
  throw new Error(`meta strip does not reconcile: kept (${kept}) != proposed - dropped + hand`);
}
// v1.3: a compact key/value grid, two pairs per row from 30rem and one per row below. the models list spans the row.
const pairs = [
  [copy.strip.sources, String(sources)],
  [copy.strip.read, String(read)],
  [copy.strip.proposed, String(proposed)],
  [copy.strip.dropped, String(dropped)],
  [copy.strip.byHand, String(hand)],
  [copy.strip.kept, String(kept)],
  [copy.strip.assembled, formatUtcTime(assembled)],
  [copy.strip.curator, curator],
];
---

<div class="border-t border-line pt-4 flex flex-col gap-4">
  <dl class="kv font-mono text-micro" aria-label={copy.strip.ariaLabel}>
    {pairs.map(([k, v]) => (
      <div class="kv-pair">
        <dt class="text-fg-3">{k}</dt>
        <dd class="text-strip-val">{v}</dd>
      </div>
    ))}
    <div class="kv-pair kv-wide">
      <dt class="text-fg-3">{copy.strip.models}</dt>
      <dd class="text-strip-val">{models.join(', ')}</dd>
    </div>
  </dl>
  <p class="font-mono text-micro text-fg-3">{copy.item.numbersNote}</p>
</div>
