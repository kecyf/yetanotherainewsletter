---
import { copy } from '../content/copy';
const { current } = Astro.props as { current?: string };
const links = [
  { key: 'archive', href: '/archive', label: copy.nav.archive },
  { key: 'api', href: '/api', label: copy.nav.api },
  { key: 'about', href: '/about', label: copy.nav.about },
];
---

<nav class="nav-gap flex flex-wrap items-center justify-between gap-x-4" aria-label={copy.nav.label}>
  <a class="wordmark tap-box -ml-2" href="/">{copy.site.brand}</a>
  <div class="flex items-center -mr-2">
    {links.map((l) => (
      <a
        class="tap-box nav-link fs-small"
        href={l.href}
        aria-current={current === l.key ? 'page' : undefined}
      >{l.label}</a>
    ))}
  </div>
</nav>
