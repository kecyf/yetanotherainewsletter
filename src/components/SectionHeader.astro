---
// v1.1 (DESIGN.md §10.3.3): the section name is a kicker — the caps are a
// display transform via the --tt-kicker token; the authored name stays as written in copy.ts.
interface Props {
  name: string;
  descriptor: string;
  id?: string;
}
const { name, descriptor, id } = Astro.props;
---

<div class="flex items-baseline gap-2 flex-wrap">
  <h2 class="kicker fs-kicker font-medium text-fg-3" id={id}>{name}</h2>
  <span class="fs-kicker text-fg-3">{descriptor}</span>
</div>