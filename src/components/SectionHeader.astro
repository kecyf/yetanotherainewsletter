---
import Title from './Title.astro';

interface Props {
  name: string;
  descriptor: string;
  id?: string;
}
const { name, descriptor, id } = Astro.props;
---

<div class="flex items-baseline gap-2 flex-wrap">
  <Title level={2} mono id={id}>{name}</Title>
  <span class="text-micro text-fg-3">{descriptor}</span>
</div>
