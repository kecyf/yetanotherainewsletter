---
// the one label pattern (DESIGN.md §11.4). an eyebrow (latest issue / lead / a section name)
// with an optional descriptor on the same tier. the rule above exists only at a section
// boundary (rule = true); it is a block border, so it spans the full column. a heading tag
// is used for section names, a plain div for the two framing eyebrows.
interface Props {
  name: string;
  descriptor?: string;
  id?: string;
  rule?: boolean;
  tag?: 'h2' | 'div';
}
const { name, descriptor, id, rule = true, tag = 'h2' } = Astro.props;
const Tag = tag;
---

<div class={`flex items-baseline gap-x-3 flex-wrap ${rule ? 'border-t border-line pt-4' : ''}`}>
  <Tag class="eyebrow" id={id}>{name}</Tag>
  {descriptor && <span class="eyebrow-note">{descriptor}</span>}
</div>
