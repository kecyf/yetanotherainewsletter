---
// the subscribe form. deliberately inert in this pass: the sender backend is
// parked (AGENTS.md scope boundaries) — no action, no provider, no network call.
// it renders exactly as it will once a backend exists.
import { copy } from '../content/copy';

interface Props {
  variant: 'full' | 'compact';
}
const { variant } = Astro.props;
// live build with no sender wired: render an honest notice instead of a form that posts nowhere.
const closed = process.env.YAAN_LIVE === '1' && process.env.YAAN_SUBSCRIBE_OPEN !== '1';
---

{closed ? (
  <p class="text-fg-2" role="note">{copy.subscribe.closed}</p>
) : (
<form method="post" class="flex flex-col gap-2">
  {variant === 'compact' && <p class="text-micro text-fg-3">{copy.subscribe.compactPromise}</p>}
  <div class="flex flex-wrap gap-2">
    <label class="sr-only" for="email">{copy.subscribe.hiddenLabel}</label>
    <input
      id="email"
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={copy.subscribe.placeholder}
      class="bg-surface-2 border border-line-strong rounded-1 px-3 min-h-tap text-fg-1 flex-1 min-w-55"
    />
    <button
      type="submit"
      class="btn bg-surface-2 border border-line-strong text-fg-1"
    >{copy.subscribe.button}</button>
  </div>
</form>
)}
