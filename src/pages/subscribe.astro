---
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { copy } from '../content/copy';
---

<Base title={`${copy.subscribe.h1} · yaan`} description={copy.positioning.short} current="subscribe">
  <main class="col">
    <Title level={1}>{copy.subscribe.h1}</Title>
    <p class="text-fg-2">{copy.subscribe.promise}</p>
    <SubscribeForm variant="full" />
  </main>
</Base>
