---
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { copy } from '../content/copy';
---

<Base title={`${copy.subscribe.h1} · yaan`} description={copy.positioning.short}>
  <main class="col">
    <Title level={1}>{copy.subscribe.h1}</Title>
    {!(process.env.YAAN_LIVE === '1' && process.env.YAAN_SUBSCRIBE_OPEN !== '1') && <p class="text-fg-2">{copy.subscribe.promise}</p>}
    <SubscribeForm variant="full" />
  </main>
</Base>
