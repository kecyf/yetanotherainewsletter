---
import Base from '../../layouts/Base.astro';
import Title from '../../components/Title.astro';
import StateTag from '../../components/StateTag.astro';
import { copy } from '../../content/copy';
---

<Base title={`${copy.subscribe.h1} · yaan`} description={copy.positioning.short} current="subscribe">
  <main class="col">
    <div class="flex items-baseline gap-3">
      <Title level={1}>{copy.subscribe.h1}</Title>
      <StateTag state="error" />
    </div>
    <p class="text-fg-2">{copy.subscribe.error}</p>
    <p class="flex gap-4">
      <a href="/rss.xml">{copy.footer.line1.rss}</a>
      <a href="/feed.json">{copy.footer.line1.feedJson}</a>
    </p>
  </main>
</Base>
