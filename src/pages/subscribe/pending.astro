---
import Base from '../../layouts/Base.astro';
import Title from '../../components/Title.astro';
import StateTag from '../../components/StateTag.astro';
import { copy } from '../../content/copy';
---

<Base title={`${copy.subscribe.pendingH1} · yaan`} description={copy.positioning.short} current="subscribe">
  <main class="col">
    <div class="flex items-baseline gap-3">
      <Title level={1}>{copy.subscribe.pendingH1}</Title>
      <StateTag state="pending" />
    </div>
    <p class="text-fg-2">{copy.subscribe.pendingBody}</p>
  </main>
</Base>
